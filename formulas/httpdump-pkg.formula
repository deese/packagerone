EXTRACT_CMD="cp"
INSTALL_FILES=(
    "httpdump-linux-amd64|755|/usr/bin/httpdump"
)
CLEANUP_FILES="httpdump-linux-amd64"
PACKAGE_DESCRIPTION="httpdump is a tool for capturing and analyzing HTTP traffic."
PACKAGE_SUMMARY=""
PACKAGE_LICENSE="unknown"
PACKAGE_SUMMARY="httpdump is a tool for capturing and analyzing HTTP traffic."
