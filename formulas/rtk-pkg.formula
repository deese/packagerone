REPO="rtk-ai/rtk"
DPKG_BASENAME="rtk"
HOMEPAGE="https://github.com/rtk-ai/rtk"
DOWNLOAD_FILENAME="rtk-\$TARGET_ARCH-unknown-linux-musl.tar.gz"
DOWNLOAD_URL_TEMPLATE="https://github.com/\$REPO/releases/download/\$LATEST_VER/\$DOWNLOAD_FILENAME"
EXTRACT_CMD="tar zxf"
INSTALL_FILES=(
    "rtk|755|/usr/bin/rtk"
)
CLEANUP_FILES="rtk"
PACKAGE_DESCRIPTION="CLI proxy that reduces LLM token consumption by 60-90% on common dev commands. Single Rust binary, zero dependencies."
PACKAGE_SUMMARY="CLI proxy that reduces LLM token consumption by 60-90% on common dev commands. Single Rust binary, zero dependencies"
PACKAGE_LICENSE="unknown"
