REPO="aristocratos/btop"
DPKG_BASENAME="btop"
DOWNLOAD_FILENAME="btop-\$TARGET_ARCH-linux-musl.tbz"
DOWNLOAD_URL_TEMPLATE="https://github.com/\$REPO/releases/download/\$LATEST_VER/\$DOWNLOAD_FILENAME"
EXTRACT_CMD="tar xjf"
INSTALL_FILES=(
 "btop/bin/btop|755|/usr/bin/btop"
 "btop/CHANGES.md|644|/usr/share/btop/CHANGES.md"
 "btop/install.sh|755|/usr/share/btop/install.sh"
 "btop/uninstall.sh|755|/usr/share/btop/uninstall.sh"
 "btop/btop.desktop|644|/usr/share/btop/btop.desktop"
 "btop/setuid.sh|755|/usr/share/btop/setuid.sh"
 "btop/Makefile|644|/usr/share/btop/Makefile"
 "btop/README.md|644|/usr/share/btop/README.md"
 "btop/themes/kanagawa-wave.theme|644|/usr/share/btop/themes/kanagawa-wave.theme"
 "btop/themes/everforest-dark-hard.theme|644|/usr/share/btop/themes/everforest-dark-hard.theme"
 "btop/themes/flat-remix.theme|644|/usr/share/btop/themes/flat-remix.theme"
 "btop/themes/adwaita.theme|644|/usr/share/btop/themes/adwaita.theme"
 "btop/themes/night-owl.theme|644|/usr/share/btop/themes/night-owl.theme"
 "btop/themes/dracula.theme|644|/usr/share/btop/themes/dracula.theme"
 "btop/themes/tomorrow-night.theme|644|/usr/share/btop/themes/tomorrow-night.theme"
 "btop/themes/kyli0x.theme|644|/usr/share/btop/themes/kyli0x.theme"
 "btop/themes/solarized_dark.theme|644|/usr/share/btop/themes/solarized_dark.theme"
 "btop/themes/gruvbox_dark_v2.theme|644|/usr/share/btop/themes/gruvbox_dark_v2.theme"
 "btop/themes/tokyo-night.theme|644|/usr/share/btop/themes/tokyo-night.theme"
 "btop/themes/adapta.theme|644|/usr/share/btop/themes/adapta.theme"
 "btop/themes/paper.theme|644|/usr/share/btop/themes/paper.theme"
 "btop/themes/tokyo-storm.theme|644|/usr/share/btop/themes/tokyo-storm.theme"
 "btop/themes/elementarish.theme|644|/usr/share/btop/themes/elementarish.theme"
 "btop/themes/dusklight.theme|644|/usr/share/btop/themes/dusklight.theme"
 "btop/themes/kanagawa-lotus.theme|644|/usr/share/btop/themes/kanagawa-lotus.theme"
 "btop/themes/horizon.theme|644|/usr/share/btop/themes/horizon.theme"
 "btop/themes/flat-remix-light.theme|644|/usr/share/btop/themes/flat-remix-light.theme"
 "btop/themes/monokai.theme|644|/usr/share/btop/themes/monokai.theme"
 "btop/themes/onedark.theme|644|/usr/share/btop/themes/onedark.theme"
 "btop/themes/gruvbox_material_dark.theme|644|/usr/share/btop/themes/gruvbox_material_dark.theme"
 "btop/themes/ayu.theme|644|/usr/share/btop/themes/ayu.theme"
 "btop/themes/matcha-dark-sea.theme|644|/usr/share/btop/themes/matcha-dark-sea.theme"
 "btop/themes/everforest-light-medium.theme|644|/usr/share/btop/themes/everforest-light-medium.theme"
 "btop/themes/HotPurpleTrafficLight.theme|644|/usr/share/btop/themes/HotPurpleTrafficLight.theme"
 "btop/themes/whiteout.theme|644|/usr/share/btop/themes/whiteout.theme"
 "btop/themes/gruvbox_dark.theme|644|/usr/share/btop/themes/gruvbox_dark.theme"
 "btop/themes/everforest-dark-medium.theme|644|/usr/share/btop/themes/everforest-dark-medium.theme"
 "btop/themes/solarized_light.theme|644|/usr/share/btop/themes/solarized_light.theme"
 "btop/themes/adwaita-dark.theme|644|/usr/share/btop/themes/adwaita-dark.theme"
 "btop/themes/gruvbox_light.theme|644|/usr/share/btop/themes/gruvbox_light.theme"
 "btop/themes/nord.theme|644|/usr/share/btop/themes/nord.theme"
 "btop/themes/greyscale.theme|644|/usr/share/btop/themes/greyscale.theme"
 "btop/themes/phoenix-night.theme|644|/usr/share/btop/themes/phoenix-night.theme"
)
CLEANUP_FILES="btop bin/btop btop/CHANGES.md btop/install.sh btop/uninstall.sh btop/btop.desktop btop/setuid.sh btop/Makefile btop/README.md btop/themes/kanagawa-wave.theme btop/themes/everforest-dark-hard.theme btop/themes/flat-remix.theme btop/themes/adwaita.theme btop/themes/night-owl.theme btop/themes/dracula.theme btop/themes/tomorrow-night.theme btop/themes/kyli0x.theme btop/themes/solarized_dark.theme btop/themes/gruvbox_dark_v2.theme btop/themes/tokyo-night.theme btop/themes/adapta.theme btop/themes/paper.theme btop/themes/tokyo-storm.theme btop/themes/elementarish.theme btop/themes/dusklight.theme btop/themes/kanagawa-lotus.theme btop/themes/horizon.theme btop/themes/flat-remix-light.theme btop/themes/monokai.theme btop/themes/onedark.theme btop/themes/gruvbox_material_dark.theme btop/themes/ayu.theme btop/themes/matcha-dark-sea.theme btop/themes/everforest-light-medium.theme btop/themes/HotPurpleTrafficLight.theme btop/themes/whiteout.theme btop/themes/gruvbox_dark.theme btop/themes/everforest-dark-medium.theme btop/themes/solarized_light.theme btop/themes/adwaita-dark.theme btop/themes/gruvbox_light.theme btop/themes/nord.theme btop/themes/greyscale.theme btop/themes/phoenix-night.theme"
PACKAGE_DESCRIPTION="btop is a resource monitor that shows usage and stats for processor, memory, disks, network and processes. It provides an interactive terminal UI and is designed specifically for Linux, utilizing the musl C library for enhanced portability."
PACKAGE_SUMMARY="btop - a resource monitor"
PACKAGE_LICENSE="MIT"
